generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model application {
  id         String   @id @default(cuid())
  nom        String
  prenom     String
  telephone  String
  email      String
  poste      String
  experience String
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model invoice {
  id        String   @id @default(cuid())
  client    String
  service   String
  montant   Float
  date      String
  statut    String   @default("en attente")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model order {
  id           String   @id @default(cuid())
  items        String   @db.LongText
  total        Float
  nom          String?
  prenom       String?
  telephone    String?
  email        String?
  localisation String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model product {
  id          String   @id @default(cuid())
  nom         String
  description String?
  prix        Float
  quantite    Int
  categorie   String
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model realisation {
  id          String   @id @default(cuid())
  titre       String
  description String?
  type        String
  url         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model reservation {
  id             String   @id @default(cuid())
  nom            String
  prenom         String
  telephone      String
  localisation   String?
  typeService    String
  duree          String
  serviceDetails String?  @db.LongText
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model worker {
  id           String   @id @default(cuid())
  nom          String
  prenom       String
  poste        String
  telephone    String
  dateEmbauche String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model devis {
  id             String   @id @default(cuid())
  nom            String
  prenom         String
  telephone      String
  localisation   String?
  typeService    String
  description    String?
  serviceDetails String?  @db.LongText
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt])
}

model emailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String   @db.LongText
  status    String
  response  String?  @db.LongText
  createdAt DateTime @default(now())
}
